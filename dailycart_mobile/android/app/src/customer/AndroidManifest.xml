<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Foreground location is used only when the customer selects "Use my location". -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application>
        <!-- Background GPS belongs exclusively to the Rider flavor. -->
        <service
            android:name="id.flutter.flutter_background_service.BackgroundService"
            tools:node="remove" />
        <receiver
            android:name="id.flutter.flutter_background_service.WatchdogReceiver"
            tools:node="remove" />
        <receiver
            android:name="id.flutter.flutter_background_service.BootReceiver"
            tools:node="remove" />
    </application>
</manifest>
